@model CatalogoApp.Domain.Models.Item
@{
    ViewData["Title"] = "Editar - " + Model.Nombre;
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar @Model.Nombre</title>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@200;300;400&family=Raleway:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh; background: #060810; color: #e8e4df;
            font-family: 'Raleway', sans-serif; padding: 92px 28px 44px;
        }
        .mosaic-bg {
            position: fixed; inset: 0;
            display: grid; grid-template-columns: repeat(5, 1fr);
            opacity: .12; filter: grayscale(.45) saturate(.7); pointer-events: none;
        }
        .mosaic-bg img { width: 100%; height: 100%; object-fit: cover; }
        .shade {
            position: fixed; inset: 0; pointer-events: none;
            background: radial-gradient(circle at 50% 18%, rgba(212,180,80,.06), transparent 30%),
                        linear-gradient(180deg, rgba(6,8,16,.85), rgba(3,4,9,.98));
        }
        .topbar {
            position: fixed; top: 24px; left: 28px; right: 28px; z-index: 4;
            display: flex; justify-content: space-between; align-items: center; gap: 14px;
        }
        .nav-links { display: flex; gap: 10px; flex-wrap: wrap; }
        .nav-link {
            color: rgba(212,180,80,.74); border: 1px solid rgba(212,180,80,.25);
            background: rgba(6,8,16,.45); text-decoration: none; text-transform: uppercase;
            letter-spacing: 3px; font-size: 10px; padding: 10px 18px; transition: .25s ease;
        }
        .nav-link:hover { color: #e8e4df; border-color: rgba(212,180,80,.55); }
        .page { position: relative; z-index: 2; width: min(980px, 100%); margin: 0 auto; }
        .header { text-align: center; margin-bottom: 34px; }
        .eyebrow {
            display: inline-block; color: #d4b450;
            border: 1px solid rgba(212,180,80,.35); padding: 6px 18px;
            font-size: 10px; letter-spacing: 5px; text-transform: uppercase; margin-bottom: 18px;
        }
        h1 {
            font-family: 'Josefin Sans', sans-serif;
            font-size: clamp(32px, 6vw, 56px); font-weight: 200;
            letter-spacing: 6px; text-transform: uppercase;
        }
        .subtitle { color: rgba(228,220,210,.45); font-size: 12px; letter-spacing: 4px; text-transform: uppercase; margin-top: 14px; }
        form {
            border: 1px solid rgba(212,180,80,.22);
            background: linear-gradient(170deg, rgba(16,20,38,.9), rgba(8,12,24,.94));
            box-shadow: 0 36px 90px rgba(0,0,0,.45); padding: 34px;
        }
        .form-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
        .form-group { display: flex; flex-direction: column; gap: 8px; }
        .span-2 { grid-column: span 2; }
        .span-4 { grid-column: 1 / -1; }
        label { color: rgba(212,180,80,.75); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; }
        input, textarea, select {
            width: 100%; border: 1px solid rgba(228,220,210,.12);
            background: rgba(255,255,255,.035); color: #e8e4df;
            padding: 12px 13px; outline: none; font-family: 'Raleway', sans-serif; font-size: 14px;
        }
        select { cursor: pointer; }
        select option { background: #0a0e18; color: #e8e4df; }
        input:focus, textarea:focus, select:focus { border-color: rgba(212,180,80,.55); background: rgba(212,180,80,.045); }
        textarea { min-height: 104px; resize: vertical; line-height: 1.6; }
        .validation-error { color: #ff8a8a; font-size: 11px; margin-top: 2px; }
        .form-actions { display: flex; justify-content: flex-end; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
        .btn-submit {
            border: 1px solid rgba(212,180,80,.45); background: rgba(212,180,80,.9);
            color: #060810; padding: 12px 28px; font-family: 'Raleway', sans-serif;
            font-size: 11px; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: .3s;
        }
        .btn-submit:hover { background: #f0d060; transform: translateY(-2px); }
        .btn-back {
            color: rgba(212,180,80,.74); border: 1px solid rgba(212,180,80,.25);
            background: rgba(6,8,16,.45); text-decoration: none; text-transform: uppercase;
            letter-spacing: 3px; font-size: 10px; padding: 10px 18px; transition: .25s ease;
            display: inline-flex; align-items: center;
        }
        .btn-back:hover { color: #e8e4df; border-color: rgba(212,180,80,.55); }
        .photo-preview { margin-top: 8px; max-width: 120px; border-radius: 8px; border: 1px solid rgba(212,180,80,.15); }
        @@media(max-width: 900px) {
            .form-grid { grid-template-columns: repeat(2, 1fr); }
            .span-2, .span-4 { grid-column: 1 / -1; }
        }
        @@media(max-width: 600px) {
            body { padding: 104px 18px 28px; }
            .topbar { left: 18px; right: 18px; align-items: flex-start; flex-direction: column; }
            form { padding: 24px; }
            .form-grid { grid-template-columns: 1fr; }
            .form-actions { flex-direction: column-reverse; }
            .btn-submit, .btn-back { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>
    <div class="mosaic-bg" aria-hidden="true">
        <img src="/imagenes/pexels-gonzalo-acuna-166058093-18918178.jpg" alt="">
        <img src="/imagenes/pexels-el-gringo-photo-116752370-10184002.jpg" alt="">
        <img src="/imagenes/pexels-bilal-yahya-2158113463-35162974.jpg" alt="">
        <img src="/imagenes/pexels-el-gringo-photo-116752370-10287249.jpg" alt="">
        <img src="/imagenes/pexels-unknown6user-1657328.jpg" alt="">
    </div>
    <div class="shade"></div>

    <header class="topbar">
        <div class="nav-links">
            <a href="/" class="nav-link">Home</a>
            <a href="/Catalogo" class="nav-link">Catalogo</a>
            <a href="/Catalogo/Detalle/@Model.Id" class="nav-link">Ver Detalle</a>
        </div>
    </header>

    <main class="page">
        <div class="header">
            <span class="eyebrow">Editar leyenda</span>
            <h1>@Model.Nombre</h1>
            <p class="subtitle">Actualiza los datos del jugador</p>
        </div>

        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-grid">
                <div class="form-group span-2">
                    <label asp-for="Nombre">Nombre completo</label>
                    <input asp-for="Nombre" required />
                    <span asp-validation-for="Nombre" class="validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Posicion">Posicion</label>
                    <input asp-for="Posicion" required />
                </div>
                <div class="form-group">
                    <label asp-for="PosicionCorta">Posicion corta</label>
                    <input asp-for="PosicionCorta" required />
                </div>
                <div class="form-group">
                    <label asp-for="Pais">Pais</label>
                    <input asp-for="Pais" required />
                </div>
                <div class="form-group">
                    <label asp-for="PaisCodigo">Codigo pais</label>
                    <input asp-for="PaisCodigo" />
                </div>
                <div class="form-group">
                    <label asp-for="Bandera">Bandera</label>
                    <input asp-for="Bandera" />
                </div>
                <div class="form-group">
                    <label asp-for="Equipo">Equipo</label>
                    <input asp-for="Equipo" required />
                </div>
                <div class="form-group">
                    <label asp-for="FechaNacimiento">Nacimiento</label>
                    <input asp-for="FechaNacimiento" placeholder="DD/MM/AAAA" />
                </div>
                <div class="form-group">
                    <label asp-for="AlturaCm">Altura cm</label>
                    <input asp-for="AlturaCm" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="PesoKg">Peso kg</label>
                    <input asp-for="PesoKg" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="NumeroCamiseta">Camiseta</label>
                    <input asp-for="NumeroCamiseta" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="PieDominante">Pie</label>
                    <select asp-for="PieDominante">
                        <option value="Derecho">Derecho</option>
                        <option value="Izquierdo">Izquierdo</option>
                        <option value="Ambidiestro">Ambidiestro</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Goles">Goles</label>
                    <input asp-for="Goles" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="Asistencias">Asistencias</label>
                    <input asp-for="Asistencias" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="Partidos">Partidos</label>
                    <input asp-for="Partidos" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="Genero">Categoria</label>
                    <select asp-for="Genero">
                        <option value="Futbol">Futbol</option>
                        <option value="Futbol Femenino">Futbol Femenino</option>
                        <option value="Futsal">Futsal</option>
                        <option value="Leyendas">Leyendas</option>
                    </select>
                </div>
                <div class="form-group span-2">
                    <label asp-for="FotoUrl">Foto URL (tarjeta)</label>
                    <input asp-for="FotoUrl" placeholder="/imagenes/foto.jpg" />
                    @if (!string.IsNullOrWhiteSpace(Model.FotoUrl))
                    {
                        <img src="@Model.FotoUrl" alt="Preview" class="photo-preview" />
                    }
                </div>
                <div class="form-group span-2">
                    <label asp-for="FotoDetalleUrl">Foto detalle URL</label>
                    <input asp-for="FotoDetalleUrl" placeholder="/imagenes/foto-detalle.jpg" />
                    @if (!string.IsNullOrWhiteSpace(Model.FotoDetalleUrl))
                    {
                        <img src="@Model.FotoDetalleUrl" alt="Preview" class="photo-preview" />
                    }
                </div>
                <div class="form-group span-4">
                    <label asp-for="Clubes">Clubes</label>
                    <input asp-for="Clubes" placeholder="Barcelona, PSG, Inter Miami" />
                </div>
                <div class="form-group span-4">
                    <label asp-for="Descripcion">Descripcion</label>
                    <textarea asp-for="Descripcion" placeholder="Biografia del jugador..."></textarea>
                </div>
            </div>
            <div class="form-actions">
                <a href="/Catalogo/Detalle/@Model.Id" class="btn-back">Cancelar</a>
                <button type="submit" class="btn-submit">Guardar Cambios</button>
            </div>
        </form>
    </main>
</body>
</html>
