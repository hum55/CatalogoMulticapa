@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@200;300;400&family=Raleway:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #060810;
            color: #e8e4df;
            font-family: 'Raleway', sans-serif;
            padding: 28px;
            overflow: hidden;
        }
        .mosaic-bg {
            position: fixed;
            inset: 0;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            opacity: .22;
            filter: grayscale(.35) saturate(.7);
        }
        .mosaic-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .shade {
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 35%, rgba(212,180,80,.08), transparent 34%),
                        linear-gradient(180deg, rgba(6,8,16,.72), rgba(3,4,9,.96));
        }
        .nav {
            position: fixed;
            top: 26px;
            left: 32px;
            z-index: 3;
            display: flex;
            gap: 12px;
        }
        .nav a, .ghost-link {
            color: rgba(212,180,80,.74);
            border: 1px solid rgba(212,180,80,.25);
            background: rgba(6,8,16,.45);
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 10px;
            padding: 10px 18px;
            transition: .25s ease;
        }
        .nav a:hover, .ghost-link:hover {
            color: #e8e4df;
            border-color: rgba(212,180,80,.55);
        }
        .auth-shell {
            position: relative;
            z-index: 2;
            width: min(440px, 100%);
            border: 1px solid rgba(212,180,80,.28);
            background: linear-gradient(170deg, rgba(16,20,38,.94), rgba(8,12,24,.96));
            padding: 42px;
            box-shadow: 0 36px 90px rgba(0,0,0,.52);
        }
        .eyebrow {
            display: inline-block;
            color: #d4b450;
            border: 1px solid rgba(212,180,80,.35);
            padding: 6px 18px;
            font-size: 10px;
            letter-spacing: 5px;
            text-transform: uppercase;
            margin-bottom: 22px;
        }
        h1 {
            font-family: 'Josefin Sans', sans-serif;
            font-size: clamp(38px, 8vw, 58px);
            font-weight: 200;
            letter-spacing: 8px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        .sub {
            color: rgba(228,220,210,.52);
            line-height: 1.7;
            font-size: 13px;
            margin-bottom: 28px;
        }
        label {
            display: block;
            margin: 16px 0 8px;
            color: rgba(212,180,80,.76);
            font-size: 10px;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        input {
            width: 100%;
            border: 1px solid rgba(228,220,210,.12);
            border-radius: 0;
            background: rgba(255,255,255,.035);
            color: #e8e4df;
            padding: 13px 14px;
            outline: none;
            font-family: 'Raleway', sans-serif;
        }
        input:focus {
            border-color: rgba(212,180,80,.55);
            background: rgba(212,180,80,.045);
        }
        .error {
            border-left: 2px solid rgba(255,150,150,.8);
            color: #ffb6b6;
            padding: 8px 0 8px 12px;
            margin-bottom: 14px;
            font-size: 13px;
        }
        .actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-top: 28px;
        }
        button {
            border: 1px solid rgba(212,180,80,.45);
            background: rgba(212,180,80,.9);
            color: #060810;
            padding: 12px 28px;
            font-family: 'Raleway', sans-serif;
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
            cursor: pointer;
        }
        .text-link {
            color: rgba(228,220,210,.6);
            text-decoration: none;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .text-link:hover { color: #d4b450; }
        @@media(max-width: 560px) {
            body { padding: 18px; }
            .auth-shell { padding: 30px 24px; }
            .nav { left: 18px; top: 18px; }
            .actions { align-items: stretch; flex-direction: column; }
            button { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="mosaic-bg" aria-hidden="true">
        <img src="/imagenes/pexels-gonzalo-acuna-166058093-18918178.jpg" alt="">
        <img src="/imagenes/pexels-el-gringo-photo-116752370-10184002.jpg" alt="">
        <img src="/imagenes/pexels-bilal-yahya-2158113463-35162974.jpg" alt="">
        <img src="/imagenes/pexels-el-gringo-photo-116752370-10287249.jpg" alt="">
        <img src="/imagenes/pexels-unknown6user-1657328.jpg" alt="">
    </div>
    <div class="shade"></div>
    <nav class="nav">
        <a href="/">Home</a>
    </nav>

    <form class="auth-shell" method="post" asp-action="Login">
        <span class="eyebrow">Acceso</span>
        <h1>Entrar</h1>
        <p class="sub">Inicia sesion para guardar tus calificaciones y comentarios en cada jugador.</p>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <label>Correo</label>
        <input type="email" name="email" autocomplete="email" required />

        <label>Password</label>
        <input type="password" name="password" autocomplete="current-password" required minlength="4" />

        <div class="actions">
            <button type="submit">Login</button>
            <a class="text-link" asp-controller="Account" asp-action="Register">Crear cuenta</a>
        </div>
    </form>
</body>
</html>
